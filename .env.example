# Supabase — copy to .env and fill in (or set in Vercel dashboard → Environment Variables)
# IMPORTANT: .env must NOT be listed in .vercelignore, otherwise the Vercel
# build will bake `undefined` into the client bundle and every client-side
# navigation will crash with "This page didn't load".
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_PROJECT_ID=your-project

# Client-side copies (Vite inlines these at build time)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
VITE_SUPABASE_PROJECT_ID=your-project
